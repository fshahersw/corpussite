# Native Vercel -> Supabase archive. All values are server-side.
# Documentation only: never place a real secret in this tracked file.
# Migration/release remain held; read deploy/README.md before imports or deployment.

# Runtime and local import client are pinned to this existing project.
CORPUS_SUPABASE_URL=https://xosqzzsnhxcyehcnirpa.supabase.co

# Set in Vercel environment settings or a private local process environment.
# Windows import tools may instead use the existing user-bound DPAPI credential.
# Never expose this as NEXT_PUBLIC_*, VITE_* or browser/build JavaScript.
CORPUS_SUPABASE_SECRET_KEY=

# The site is public; CORPUS_SITE_PASSWORD is no longer used.

# Native hosted routing does not use CORPUS_BACKEND_ORIGIN or CORPUS_BACKEND_TOKEN.
# Python import scripts do not automatically load .env files.
